# Deepgram Voice & Speech
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_TTS_MODEL=flux-meena-en
DEEPGRAM_REGION=global
# Optional: global, in, eu, or au. Select the region near your server.
DEEPGRAM_REGION=global

# NVIDIA NIM API Key & Model endpoint
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Database (defaults to zero-config local SQLite)
DATABASE_URL=sqlite:///./interview_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/interview_agent

# Application
SECRET_KEY=dev-secret-key-change-in-production
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_FILE=logs/interview-agent.jsonl

