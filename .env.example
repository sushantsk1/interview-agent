# Deepgram API Key (Nova-3 STT and Aura-2 TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# NVIDIA NIM API Key & Model endpoint
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Database (defaults to zero-config local SQLite)
DATABASE_URL=sqlite:///./interview_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/interview_agent

# Application
SECRET_KEY=dev-secret-key-change-in-production
FRONTEND_URL=http://localhost:5173
